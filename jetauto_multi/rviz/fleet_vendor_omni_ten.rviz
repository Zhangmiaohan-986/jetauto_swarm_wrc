  Global Options:
    Background Color: 35; 35; 35
    Default Light: true
    Fixed Frame: robot_1/map
    Frame Rate: 15
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  - Class: rviz/PublishPoint
    Single click: true
    Topic: /clicked_point
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top View
      Scale: 65
      Target Frame: robot_1/map
      X: 2.6
      Y: 0.0
Window Geometry:
  Height: 900
  Width: 1440
  X: 40
  Y: 40
