# Auto detect text files and perform LF normalization
* text=auto

# Files executed or parsed inside Ubuntu/ROS must stay LF on Windows checkouts.
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.launch text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.xacro text eol=lf
CMakeLists.txt text eol=lf

# ROS bags are binary experiment evidence. Store them with Git LFS.
*.bag filter=lfs diff=lfs merge=lfs -text
